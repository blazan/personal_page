# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values before running Docker.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Admin credentials for the /admin panel.
# Use a long, unique password: this is the only thing protecting the panel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Secret used to sign admin session cookies (JWT).
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-48

# ---------------------------------------------------------------------------
# Optional. The defaults below match docker-compose.yml; only change them if
# you also change the volume mount paths there.
# ---------------------------------------------------------------------------
# Directory holding the SQLite database file (persisted in a volume).
DATA_DIR=/app/data
# Directory holding uploaded WebP images (persisted in a volume).
UPLOAD_DIR=/app/uploads
# Port the Next.js server listens on inside the container.
PORT=3000
